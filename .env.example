# Copy to .env for local development. For release builds, set this as an
# EAS environment variable (eas env:create) so it is baked into the build.
#
# Base URL of the deployed Vercel API (no trailing slash).
# When unset, the app runs local-only: on-device classification works,
# but AI reclassification, drafts, and voice transcription are disabled.
EXPO_PUBLIC_PEA_API_URL=https://your-deployment.vercel.app
