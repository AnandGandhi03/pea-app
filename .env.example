# Copy to .env for local development. For release builds, set this in
# eas.json (build.production.env) — it is a public URL, not a secret.
#
# Base URL of the deployed Vercel API (no trailing slash).
# When unset, the app runs local-only: typed captures and on-device sorting
# work, but AI re-sorting, drafts, and voice transcription are disabled.
EXPO_PUBLIC_PEA_API_URL=https://your-deployment.vercel.app
